# Paperless-AI Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# REQUIRED: Paperless-ngx Connection
# =============================================================================
PAPERLESS_API_URL=http://your-paperless-host:8000/api
PAPERLESS_API_TOKEN=your-api-token-here

# =============================================================================
# AI Provider Configuration
# =============================================================================
# Options: ollama, openai, azure, custom
AI_PROVIDER=ollama

# Ollama Settings
OLLAMA_API_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b

# OpenAI Settings (if using openai provider)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# Document Processing
# =============================================================================
# Cron schedule for scanning new documents
SCAN_INTERVAL=*/30 * * * *

# Enable/disable features (yes/no)
ACTIVATE_TAGGING=yes
ACTIVATE_CORRESPONDENTS=no
ACTIVATE_DOCUMENT_TYPE=yes
ACTIVATE_TITLE=yes
ACTIVATE_CUSTOM_FIELDS=no

# =============================================================================
# Restriction Settings (RECOMMENDED: keep all as 'yes')
# =============================================================================
# When 'yes', AI can only use existing items, won't create new ones
RESTRICT_TO_EXISTING_TAGS=yes
RESTRICT_TO_EXISTING_CORRESPONDENTS=yes
RESTRICT_TO_EXISTING_DOCUMENT_TYPES=yes
USE_EXISTING_DATA=yes

# =============================================================================
# RAG Chat Features (optional - requires Qdrant)
# =============================================================================
# Set to 'yes' to enable semantic search / RAG chat
# Requires Qdrant container (see docker-compose.yml)
RAG_ENABLED=no

# =============================================================================
# Optional: Custom System Prompt
# =============================================================================
# SYSTEM_PROMPT=You are a document analyzer...

# =============================================================================
# Optional: Custom Fields Configuration
# =============================================================================
# CUSTOM_FIELDS={"custom_fields":[{"value":"Amount","data_type":"monetary"}]}
